# Copy to .env on the VPS. Do not commit .env.
NODE_ENV=production
PORT=3000
MERCHANT_PORT=3001
PUBLIC_APP_ORIGIN=https://temudz.store
PUBLIC_MERCHANT_ORIGIN=https://merchant.temudz.store
ACME_EMAIL=replace-with-your-email@example.com

# Conservative defaults. These do not evade merchant security controls.
TEMBY_FILTER_MODE=off
TEMBY_DIRECT_ASSETS=0
