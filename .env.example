# Copy to .env on the VPS. Do not commit .env.
NODE_ENV=production
PORT=3000
MERCHANT_PORT=3001
PUBLIC_APP_ORIGIN=https://temudz.store
PUBLIC_MERCHANT_ORIGIN=https://merchant.temudz.store
ACME_EMAIL=replace-with-your-email@example.com

# Conservative defaults. These do not evade merchant security controls.
TEMBY_FILTER_MODE=off
TEMBY_DIRECT_ASSETS=0

# Never set this in production. It exists only for a local owned-fixture test
# server and production startup rejects it if it is enabled.
# TEMBY_OWNED_FIXTURES=0

# Redis-backed session policy. A larger value is not a performance guarantee;
# it is a protective admission ceiling above the 2,000-user load-test target.
SESSION_CAPACITY=2500
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace-with-a-long-random-secret
SESSION_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
